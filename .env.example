# shrud environment. Copy to .env and fill in.
#
# .env is git-ignored. Confirm that before your first commit:
#     git check-ignore -v .env
# If it prints nothing, stop and fix .gitignore.

# ─── RPC ─────────────────────────────────────────────────────────────────────────────────────
# Split into base URL and key on purpose. viem serialises the request URL into every transport
# error, so a key inside a URL ends up in stack traces, CI logs and screenshots. The base URL is
# not secret and may be logged; the key never is.
#
# shrud refuses keyless public endpoints. eth_getLogs behaviour differs silently between them,
# so a partial history would look like a complete one.
ALCHEMY_API_URL=https://eth-sepolia.g.alchemy.com/v2/
ALCHEMY_API_KEY=

# Or set your own provider endpoint instead of the pair above.
#SEPOLIA_RPC_URL=

# ─── Indexer ─────────────────────────────────────────────────────────────────────────────────
# Optional. The indexer starts at 500 blocks per eth_getLogs query and halves the window until the
# provider accepts it, so it finds the real limit without being told. Set this to skip that.
#SEPOLIA_LOG_RANGE=

# Where the indexer follows from. Both come from deployments/11155111.json.
#SHRUD_INTENT_BOOK=
#SHRUD_START_BLOCK=

# Local development node. Defaults to http://127.0.0.1:8545 when unset.
#LOCAL_RPC_URL=

# ─── Deployment ──────────────────────────────────────────────────────────────────────────────
# Must be exactly "true". A deployment is irreversible and costs gas, so it needs an opt-in that
# is separate from running the command.
DEPLOY_SEPOLIA=false

# Must hold nothing but gas. Never reuse a key that holds value.
DEPLOYER_PRIVATE_KEY=

# Etherscan v2, for source verification.
ETHERSCAN_API_KEY=

# ─── iExec Nox ───────────────────────────────────────────────────────────────────────────────
# Sepolia defaults live in source-lock.json and the SDK resolves them on its own. Set these only
# to point at a local stack, whose gateway port Docker assigns at run time.
NOX_GATEWAY_URL=
NOX_COMPUTE_ADDRESS=0x24Ef36Ec5b626D7DCD09a98F3083c2758F0F77bF

# ─── Web application ─────────────────────────────────────────────────────────────────────────
# Free, from https://dashboard.reown.com (formerly WalletConnect Cloud).
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=11155111

# Read endpoint for the browser. Optional: viem's default public Sepolia endpoint works, because
# the web app only makes eth_getCode and eth_call reads rather than paginating logs.
#
# Anything in a NEXT_PUBLIC_ variable ships to the browser. Use a domain-restricted key here, never
# the same unrestricted one the deploy scripts use.
#NEXT_PUBLIC_RPC_URL=

# Set after deploying the indexer, for example on Render.
#NEXT_PUBLIC_INDEXER_URL=
